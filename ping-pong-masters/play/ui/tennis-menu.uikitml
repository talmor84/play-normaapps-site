<!--
  Table tennis menu, at the side of the player's end of the table. Point the
  free hand at it and pull the trigger. TennisSystem wires every button by id
  and highlights the selected mode, difficulty and hand.
  No CSS comments inside the style block.
-->
<style>
  .menu {
    flex-direction: column;
    width: 420px;
    padding-top: 18px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
    gap: 10px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #e8c46a;
  }

  .title {
    color: #1c1d20;
    font-size: 26px;
    font-weight: 700;
  }

  .title:dark {
    color: #fafaf7;
  }

  .label {
    color: #3a3b40;
    font-size: 15px;
    font-weight: 700;
    padding-top: 4px;
  }

  .label:dark {
    color: #b9bbc2;
  }

  .row {
    flex-direction: row;
    gap: 8px;
  }

  .grow {
    flex-grow: 1;
    justify-content: center;
  }

  .build {
    color: #6a6c73;
    font-size: 13px;
  }

  .build:dark {
    color: #9a9ca3;
  }
  .vol {
    color: #3a3b40;
    font-size: 14px;
    width: 92px;
    text-align: center;
    padding-top: 10px;
  }

  .vol:dark {
    color: #d9dbe2;
  }

  .consent {
    flex-direction: column;
    gap: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #1e4f9c;
  }

  .consent-text {
    color: #1c1d20;
    font-size: 15px;
    line-height: 1.3;
  }

  .consent-text:dark {
    color: #eceef2;
  }

  .status {
    color: #1e4f9c;
    font-size: 13px;
  }

  .status:dark {
    color: #8fb8ff;
  }
</style>
<Panel class="menu">
  <div id="menu-eyebrow" class="eyebrow">NORMA SPATIAL LAB</div>
  <div class="title">Ping Pong Masters</div>
  <div class="label">GAME</div>
  <div class="row">
    <Button id="btn-match" class="grow">
      <ButtonLabel>Match to 11</ButtonLabel>
    </Button>
    <Button id="btn-practice" class="grow">
      <ButtonLabel>Practice</ButtonLabel>
    </Button>
  </div>
  <div class="label">OPPONENT: MASTER KAITO</div>
  <div class="row">
    <Button id="btn-easy" class="grow">
      <ButtonLabel>Easy</ButtonLabel>
    </Button>
    <Button id="btn-medium" class="grow">
      <ButtonLabel>Medium</ButtonLabel>
    </Button>
    <Button id="btn-hard" class="grow">
      <ButtonLabel>Hard</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="btn-pause" class="grow">
      <ButtonIcon>
        <Pause></Pause>
      </ButtonIcon>
      <ButtonLabel id="pause-label">Pause</ButtonLabel>
    </Button>
    <Button id="btn-restart" class="grow">
      <ButtonIcon>
        <RotateCcw></RotateCcw>
      </ButtonIcon>
      <ButtonLabel>Restart</ButtonLabel>
    </Button>
  </div>
  <div class="label">YOU</div>
  <div class="row">
    <Button id="btn-right" class="grow">
      <ButtonLabel>Right hand</ButtonLabel>
    </Button>
    <Button id="btn-left" class="grow">
      <ButtonLabel>Left hand</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="btn-lower" class="grow">
      <ButtonIcon>
        <ArrowDown></ArrowDown>
      </ButtonIcon>
      <ButtonLabel>Table</ButtonLabel>
    </Button>
    <Button id="btn-higher" class="grow">
      <ButtonIcon>
        <ArrowUp></ArrowUp>
      </ButtonIcon>
      <ButtonLabel>Table</ButtonLabel>
    </Button>
    <Button id="btn-closer" class="grow">
      <ButtonLabel>Closer</ButtonLabel>
    </Button>
    <Button id="btn-farther" class="grow">
      <ButtonLabel>Back</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="btn-recentre" class="grow">
      <ButtonIcon>
        <LocateFixed></LocateFixed>
      </ButtonIcon>
      <ButtonLabel>Recentre me</ButtonLabel>
    </Button>
    <Button id="btn-lab" class="grow">
      <ButtonIcon>
        <House></House>
      </ButtonIcon>
      <ButtonLabel>Back to lab</ButtonLabel>
    </Button>
  </div>
  <div class="label">KAITO'S VOICE</div>
  <div class="row">
    <Button id="btn-trash" class="grow">
      <ButtonLabel id="trash-label">Trash talk: Competitive</ButtonLabel>
    </Button>
    <Button id="btn-coach" class="grow">
      <ButtonLabel id="coach-label">Coaching: Occasional tips</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="btn-chat" class="grow">
      <ButtonLabel id="chat-label">Talks: Normal</ButtonLabel>
    </Button>
    <Button id="btn-voice-mute" class="grow">
      <ButtonIcon>
        <VolumeX></VolumeX>
      </ButtonIcon>
      <ButtonLabel id="mute-label">Mute Kaito</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="btn-vol-down">
      <ButtonIcon>
        <Volume1></Volume1>
      </ButtonIcon>
    </Button>
    <div id="vol-label" class="vol">Voice 80%</div>
    <Button id="btn-vol-up">
      <ButtonIcon>
        <Volume2></Volume2>
      </ButtonIcon>
    </Button>
  </div>
  <div class="row">
    <Button id="btn-talk" class="grow" style="display: none">
      <ButtonIcon>
        <Mic></Mic>
      </ButtonIcon>
      <ButtonLabel id="talk-label">Talk</ButtonLabel>
    </Button>
    <Button id="btn-mic" class="grow" style="display: none">
      <ButtonIcon>
        <MicOff></MicOff>
      </ButtonIcon>
      <ButtonLabel id="mic-label">Mic off</ButtonLabel>
    </Button>
    <Button id="btn-adult" class="grow" style="display: none">
      <ButtonLabel id="adult-label">Swearing off</ButtonLabel>
    </Button>
    <Button id="btn-voice-pick" class="grow" style="display: none">
      <ButtonLabel id="voice-pick-label">Voice: Kaito local</ButtonLabel>
    </Button>
  </div>
  <div class="label">ROOM AND FEEL</div>
  <div class="row">
    <Button id="btn-env-dojo" class="grow">
      <ButtonLabel>Dojo</ButtonLabel>
    </Button>
    <Button id="btn-env-arena" class="grow">
      <ButtonLabel>Arena</ButtonLabel>
    </Button>
    <Button id="btn-haptics" class="grow">
      <ButtonLabel id="haptics-label">Haptics: Normal</ButtonLabel>
    </Button>
  </div>
  <div id="consent-box" class="consent" style="display: none">
    <div id="consent-text" class="consent-text">Talk lets Kaito hear you.</div>
    <div class="row">
      <Button id="btn-consent-yes" class="grow">
        <ButtonLabel>Allow microphone</ButtonLabel>
      </Button>
      <Button id="btn-consent-no" class="grow">
        <ButtonLabel>No, voice only</ButtonLabel>
      </Button>
    </div>
  </div>
  <div id="voice-status" class="status"> </div>
  <div id="setup-text" class="build">Table 76 cm. Seat 45 cm behind the end line.</div>
  <div class="row">
    <Button id="xr-button" class="grow">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel>Enter VR</ButtonLabel>
    </Button>
    <Button id="exit-button" class="grow" style="display: none">
      <ButtonIcon>
        <LogIn></LogIn>
      </ButtonIcon>
      <ButtonLabel>Exit to browser</ButtonLabel>
    </Button>
  </div>
  <div id="build-text" class="build">Tennis build 1</div>
</Panel>
