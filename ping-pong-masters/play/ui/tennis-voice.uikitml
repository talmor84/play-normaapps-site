<!--
  Speech bubble above the computer opponent. Shows what Marlo says (and what
  the player said, when Talk is on) as captions, plus a listening indicator.
  TennisVoiceBridge fills every element by id and follows the opponent.
  No CSS comments inside the style block.
-->
<style>
  .bubble {
    flex-direction: column;
    width: 380px;
    padding-top: 14px;
    padding-bottom: 16px;
    padding-left: 20px;
    padding-right: 20px;
    gap: 6px;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .speaker {
    color: #1e4f9c;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .speaker:dark {
    color: #8fb8ff;
  }

  .state {
    color: #1f7a46;
    font-size: 15px;
    font-weight: 700;
  }

  .state:dark {
    color: #7fe0a6;
  }

  .line {
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
  }

  .line:dark {
    color: #fafaf7;
  }
</style>
<Panel class="bubble">
  <div class="head">
    <div id="voice-speaker" class="speaker">MARLO</div>
    <div id="voice-state" class="state"> </div>
  </div>
  <div id="voice-line" class="line">Ready when you are.</div>
</Panel>
